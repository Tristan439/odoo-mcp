{
  "name": "odoo-connect-mcp",
  "version": "0.1.0",
  "description": "Connect Claude, ChatGPT or any MCP-compatible AI to your Odoo, with a simple setup page and per-app access control.",
  "scripts": {
    "test": "node --test",
    "start": "node bin/odoo-connect-mcp.js",
    "setup": "node bin/odoo-connect-mcp.js setup"
  },
  "keywords": [
    "odoo",
    "mcp",
    "claude",
    "chatgpt",
    "erp",
    "model-context-protocol"
  ],
  "author": "odoo-connect-mcp contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "bin": {
    "odoo-connect-mcp": "bin/odoo-connect-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.fr.md",
    "LICENSE",
    "docs",
    "SETUP-PROMPT.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
